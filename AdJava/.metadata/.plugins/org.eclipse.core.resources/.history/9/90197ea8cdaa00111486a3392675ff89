package assignment7.q2;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.Scanner;
import assignment7.Book;


public class BookManagementHashMap {

	public static void main(String[]args) {
		Scanner sc=new Scanner(System.in);
		HashMap<Integer,Book>al=new HashMap<>();
		while(true) {
			 System.out.println(""" 
			 		
			 	1. Add Book
					2. Display All Books
					3. Search Book by ID
					4. Update Book
					5. Delete Book
					6. Exit
					Enter the choise = 
			            """);
			 int ch = 0;
			 try {
				 ch=sc.nextInt();
			 }catch(Exception e) {
				 System.out.println("Invalid Input");
			 }
			 switch(ch) {
				 case 1:{
					 try {
						 System.out.println("add");
						 System.out.print("Enter id = ");
						 int id=sc.nextInt();
						 System.out.print("Enter title = ");
						 String title=sc.next();
						 System.out.print("Enter author = ");
						 String author=sc.next();
						 System.out.print("Enter price = ");
						 int price=sc.nextInt();
						 Book b=new Book(id,title,author,price);
						 al.put(id,b);
						 //al.add(id,b);
						 break;
					 }catch (Exception e){
						 System.out.println("invalid input");
						 break;
					 }
				 }
				 case 2:{
					 System.out.println("display all");
					 int n=al.size();
					 if(n>0) {
						 for (HashMap.Entry<Integer, Book> entry : al.entrySet()) {
	                            entry.getValue().displayBook();
	                        }
					 }
					 else {
						 System.out.println("No data found");
					 }
					 break;
				 }
				 case 3:{
					 try {
						 System.out.println("Search Book by ID");
						 System.out.println("Enter id to search = ");
						 int id=sc.nextInt();
						 int c=0;
						 if (al.containsKey(id)) {
		                        Book book = al.get(id);

		                        System.out.println("\nBook Found:");
		                        book.displayBook();
		                    } else {
		                        System.out.println("Book not found.");
		                    }						 if(c==0)System.out.println("No Books found");
						 break;
					 }catch (Exception e){
						 System.out.println("invalid input");
						 break;
					 }
					 
				 }
				 case 4:{

		                try {
		                    System.out.println("Update Book");

		                    System.out.print("Enter id to update = ");
		                    int id = sc.nextInt();

		                    if (al.containsKey(id)) {

		                        Book oldBook = al.get(id);

		                        System.out.println("Previous title = " + oldBook.title);
		                        System.out.print("Enter new title = ");
		                        String ntitle = sc.next();

		                        System.out.println("Previous author = " + oldBook.author);
		                        System.out.print("Enter new author = ");
		                        String nauthor = sc.next();

		                        System.out.println("Previous price = " + oldBook.price);
		                        System.out.print("Enter new price = ");
		                        int nprice = sc.nextInt();

		                        Book nb = new Book(id, ntitle, nauthor, nprice);

		                        // Replace old Book with new Book
		                        al.put(id, nb);

		                        System.out.println("Book updated successfully");

		                    } else {

		                        System.out.println("No Books found");
		                    }

		                    break;

		                } catch (Exception e) {
		                    System.out.println("Invalid input");
		                    sc.nextLine();
		                    break;
		                }
		            }
				 case 5:{
					 try {
						 System.out.println("Delete Book");
						 System.out.println("Enter id to Delete = ");
						 int id=sc.nextInt();
						 if(al.containsKey(id)) {
							 al.remove(id);
						 }
						 else{
							 System.out.println("Books Not found");
						 }
						 break;
					 }catch (Exception e){
						 System.out.println("invalid input");
						 break;
					 }
				 }
				 case 6:{
					 System.out.println("6. Exit");
					 System.exit(0);
				 }
			 }
			 //sc.close();
			 
		}
		
	}
}
