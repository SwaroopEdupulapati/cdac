package Assignment2;

import java.util.Scanner;

public class LargestofTwoNumbers {
	public static void main(String[]args){
        Scanner sc = new Scanner(System.in);

        int p=sc.nextInt();
        int b=sc.nextInt();
        System.out.println(ln(p,b));
        sc.close();
    }
    public static int ln(int n,int n1){
        int a=0;
        if(n>n1){
            //System.out.println(p+" "+ "is greater than"+b);
            a=n;
        }
        else if(n==n1){
            //System.out.println("both are same");
            a=-1;
        }
        else{
            //System.out.println(b+" "+ "is greater than"+p);
            a=n1;
        }
        return a;
    }
}
