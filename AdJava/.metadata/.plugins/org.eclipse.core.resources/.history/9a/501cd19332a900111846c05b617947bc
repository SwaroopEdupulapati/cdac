package Assignment2;

import java.util.Scanner;

public class StudentGradeCalculation {
	static Scanner sc = new Scanner(System.in);
    public static Character grade(int m){
        if(m>=90 && m<=100){
            return 'A';
        }
        else if (m<90 &&m>=75){
            return 'B';
        }
        else if (m<75 &&m>=60){
            return 'C';
        }
        else if (m<60 &&m>=50){
            return 'D';
        }
        else if (m <50 && m>=0){
            return 'F';
        }
        return 'N';
    }
    public static void main(String[] args) {
        int m=sc.nextInt();
        System.out.println(grade(m));
    }
}
